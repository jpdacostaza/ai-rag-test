{
  "project": {
    "name": "AI RAG Document Processing System",
    "version": "2.0.0",
    "description": "Advanced document processing system with RAG capabilities",
    "architecture": "microservices",
    "technologies": {
      "backend": ["Python", "FastAPI", "asyncio", "uvicorn"],
      "database": ["ChromaDB", "Redis", "PostgreSQL"],
      "ai_ml": ["LangChain", "sentence-transformers", "OpenAI", "Ollama"],
      "infrastructure": ["Docker", "docker-compose", "nginx"],
      "monitoring": ["Prometheus", "Grafana", "logging"]
    },
    "features": {
      "document_processing": {
        "supported_formats": ["PDF", "TXT", "DOCX", "MD", "JSON", "CSV"],
        "max_file_size": "10MB",
        "processing_speed": "2-15 seconds depending on size",
        "chunking_strategy": "recursive_character_splitting"
      },
      "rag_capabilities": {
        "semantic_search": true,
        "vector_embeddings": "all-MiniLM-L6-v2",
        "similarity_threshold": 0.7,
        "max_results": 10,
        "context_preservation": true
      },
      "memory_system": {
        "short_term": "Redis",
        "long_term": "ChromaDB",
        "importance_classification": true,
        "conversation_context": true,
        "user_isolation": true
      },
      "api_endpoints": {
        "upload_document": "/upload/document",
        "search_documents": "/upload/search",
        "supported_formats": "/upload/formats",
        "upload_json": "/upload/document_json",
        "search_json": "/upload/search_json"
      }
    },
    "performance_metrics": {
      "document_processing": {
        "small_files": "1-2 seconds",
        "medium_files": "3-5 seconds",
        "large_files": "8-15 seconds"
      },
      "search_performance": {
        "average_query_time": "50-100ms",
        "similarity_accuracy": "85-90%",
        "result_relevance": "90%+ user satisfaction"
      },
      "system_reliability": {
        "uptime_target": "99.9%",
        "error_rate": "< 1%",
        "response_time": "< 100ms"
      }
    },
    "configuration": {
      "chunking": {
        "default_chunk_size": 1000,
        "arm64_chunk_size": 600,
        "chunk_overlap": 200,
        "arm64_overlap": 50,
        "max_search_limit": 50,
        "arm64_search_limit": 10
      },
      "memory_classification": {
        "short_term_threshold": 0.2,
        "long_term_threshold": 0.5,
        "importance_keywords": [
          "remember", "important", "deadline", "appointment",
          "personal", "contact", "preference", "setting"
        ]
      },
      "database_settings": {
        "redis_ttl": 3600,
        "chroma_collection": "rag_memories",
        "embedding_model": "all-MiniLM-L6-v2",
        "similarity_function": "cosine"
      }
    },
    "development_status": {
      "current_phase": "production_ready",
      "completion_percentage": 95,
      "last_updated": "2025-08-18",
      "next_milestones": [
        "relevance_scoring_implementation",
        "performance_monitoring_dashboard",
        "user_preference_learning",
        "multi_language_support"
      ]
    },
    "team": {
      "lead_developer": "John Doe",
      "product_manager": "Sarah Johnson",
      "devops_engineer": "Mike Chen",
      "team_size": 3,
      "development_methodology": "agile_scrum"
    }
  }
}
