# Custom Pipelines Dockerfile - Zero-Config Compatible
# Extends the official OpenWebUI pipelines image with dependency fixes

FROM ghcr.io/open-webui/pipelines:main

# Set working directory
WORKDIR /app

# Copy our dependency requirements
COPY pipelines/requirements.txt /app/pipelines/requirements.txt
COPY pipelines/startup.sh /app/startup.sh

# Make startup script executable
RUN chmod +x /app/startup.sh

# Install our fixed dependencies for zero-config compatibility
RUN pip install --no-cache-dir --upgrade \
    "pydantic>=2.8.0,<2.12.0" \
    "langchain>=0.1.0,<0.2.0" \
    "langchain-community>=0.0.38,<0.1.0" \
    "langchain-openai>=0.0.8,<0.1.0" \
    "langchain-text-splitters>=0.0.1,<0.1.0"

# Verify installation
RUN python3 -c "import langchain; print(f'LangChain version: {langchain.__version__}')"

# Use our startup script
ENTRYPOINT ["/app/startup.sh"]
CMD ["bash", "start.sh"]
