# Custom Pipelines Dockerfile - Zero-Config Compatible  
# Extends the official OpenWebUI pipelines image with optimized dependency management

FROM ghcr.io/open-webui/pipelines:main

# Set working directory
WORKDIR /app

# Copy our dependency requirements and optimized startup script
COPY pipelines/requirements.txt /app/pipelines/requirements.txt
COPY pipelines/startup.sh /app/startup.sh

# Make startup script executable
RUN chmod +x /app/startup.sh

# NOTE: Dependencies are now installed by the optimized startup script
# to prevent duplicate installations and reduce container size

# Use our optimized startup script
ENTRYPOINT ["/app/startup.sh"]
CMD ["bash", "start.sh"]
