{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(message)s"
        }
    },
    "handlers": {
        "null": {
            "class": "logging.NullHandler"
        }
    },
    "loggers": {
        "uvicorn": {
            "handlers": ["null"],
            "level": "ERROR",
            "propagate": false
        },
        "uvicorn.access": {
            "handlers": ["null"],
            "level": "ERROR",
            "propagate": false
        },
        "uvicorn.error": {
            "handlers": ["null"],
            "level": "ERROR",
            "propagate": false
        }
    },
    "root": {
        "level": "ERROR",
        "handlers": ["null"]
    }
}
