FROM python:3.12-slim

WORKDIR /app

# Install system dependencies including build tools temporarily
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (including any that need compilation)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for the enhanced gateway
RUN pip install --no-cache-dir \
    aiohttp==3.9.5 \
    PyJWT==2.8.0 \
    pyyaml==6.0.1 \
    psutil==5.9.8

# Clean up build dependencies to reduce image size
RUN apt-get update && apt-get remove -y \
    gcc \
    python3-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/config

# Expose port
EXPOSE 8888

# Health check for enhanced gateway
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8888/gateway/health || exit 1

# Run the enhanced API gateway
CMD ["python", "-m", "core.enhanced_api_gateway"]
