# ARM64-optimized Docker Compose override for Orange Pi 5 Plus and similar devices
# Use with: docker-compose -f docker-compose.yml -f docker-compose.arm64.yml up

version: '3.8'

services:
  # Ollama with ARM64 optimizations
  ollama:
    environment:
      - OLLAMA_ORIGINS="*"
      - OLLAMA_HOST=0.0.0.0:11434
      - OLLAMA_MAX_LOADED_MODELS=1  # Limit loaded models for memory management
      - OLLAMA_NUMA=false           # Disable NUMA for single-socket ARM devices
      - OLLAMA_MAX_VRAM=4096        # Limit VRAM usage (adjust based on your RAM)
    healthcheck:
      test: ["CMD-SHELL", "pgrep ollama || exit 1"]
      interval: 60s      # Longer intervals for slower ARM64
      timeout: 30s       # Longer timeout for health checks
      retries: 5
      start_period: 120s # More time for ARM64 to start
    deploy:
      resources:
        limits:
          memory: 8G     # Adjust based on your Orange Pi's available RAM
        reservations:
          memory: 4G

  # Backend with ARM64 optimizations
  backend:
    environment:
      - ENV=production
      - PYTHONPATH=/app
      - PYTHONUNBUFFERED=1
      - OLLAMA_BASE_URL=http://backend-ollama:11434
      - LOG_REQUESTS=false
      - ARM64_OPTIMIZED=true        # Enable ARM64 optimizations
      - LLM_TIMEOUT=180             # Longer timeout for ARM64
      - OLLAMA_REQUEST_TIMEOUT=180  # HTTP client timeout for Ollama requests
      - HTTPX_TIMEOUT=180           # HTTPX client timeout
      - REQUEST_TIMEOUT=180         # General request timeout
      - EMBEDDING_BATCH_SIZE=16     # Smaller batches for memory management
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health/simple"]
      interval: 30s
      timeout: 20s      # Longer timeout for ARM64
      retries: 8
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 4G
        reservations:
          memory: 2G

  # Memory API with ARM64 optimizations
  memory-api:
    environment:
      - REDIS_URL=redis://backend-redis:6379
      - CHROMA_URL=http://backend-chroma:8000
      - ARM64_OPTIMIZED=true
      - EMBEDDING_BATCH_SIZE=8      # Smaller batches
      - MEMORY_CACHE_SIZE=100       # Reduce cache size
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G

  # Pipelines with ARM64 optimizations
  pipelines:
    environment:
      - ARM64_OPTIMIZED=true
      - EMBEDDING_BATCH_SIZE=8
      - PIPELINE_TIMEOUT=300        # Longer timeout for processing
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G

  # ChromaDB with ARM64 optimizations
  chroma:
    environment:
      - CHROMA_SERVER_AUTHN_CREDENTIALS_FILE=/chroma/auth.txt
      - CHROMA_SERVER_AUTHN_PROVIDER=chromadb.auth.basic.BasicAuthenticationServerProvider
      - ANONYMIZED_TELEMETRY=false  # Disable telemetry for performance
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G

  # Redis with ARM64 optimizations
  redis:
    command: redis-server --appendonly yes --maxmemory 512mb --maxmemory-policy allkeys-lru --save 300 1
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M

  # OpenWebUI with ARM64 optimizations
  openwebui:
    environment:
      - OLLAMA_BASE_URL=http://backend-ollama:11434
      - WEBUI_AUTH=true             # Enable authentication
      - ENABLE_SIGNUP=true          # Allow user registration
      - DEFAULT_USER_ROLE=user      # Set default role
      - ARM64_OPTIMIZED=true
      - REQUEST_TIMEOUT=180         # Longer timeout for ARM64
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M
