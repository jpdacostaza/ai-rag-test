# Dockerfile.memory - Integrated Memory API with Auto-Setup
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc g++ make python3-dev build-essential \
    libffi-dev libssl-dev zlib1g-dev \
    libc6-dev pkg-config sqlite3 libsqlite3-dev \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies with proper pip configuration
RUN python -m pip install --upgrade pip==23.3.1 wheel setuptools

# Install PyTorch CPU-only first
RUN python -m pip install --timeout=1000 --retries=10 \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install FastAPI and core dependencies
RUN python -m pip install --timeout=1000 --retries=10 \
    fastapi uvicorn[standard] python-multipart pydantic redis chromadb requests httpx aiofiles

# Copy all necessary files for the memory API
COPY memory/ /app/memory/
COPY core/ /app/core/
COPY utilities/ /app/utilities/
COPY services/ /app/services/
COPY scripts/fixed_memory_api_v2.py /app/scripts/fixed_memory_api_v2.py
COPY config/ /app/config/
COPY requirements.txt /app/requirements.txt

# Install dependencies from requirements.txt
RUN python -m pip install --timeout=1000 --retries=10 -r requirements.txt

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 5001

# Run the fixed memory API
CMD ["python", "/app/scripts/fixed_memory_api_v2.py"]
