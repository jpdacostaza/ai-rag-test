# Dockerfile.memory - Integrated Memory API with Auto-Setup
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first
RUN pip install fastapi uvicorn[standard] python-multipart pydantic redis chromadb requests httpx aiofiles

# Copy all necessary files for the memory API
COPY memory/ /app/memory/
COPY core/ /app/core/
COPY utilities/ /app/utilities/
COPY services/ /app/services/
COPY scripts/fixed_memory_api_v2.py /app/scripts/fixed_memory_api_v2.py
COPY config/ /app/config/
COPY requirements.txt /app/requirements.txt

# Install dependencies from requirements.txt
RUN pip install -r requirements.txt

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 5001

# Run the complete memory API
CMD ["python", "/app/memory/api/main.py"]
