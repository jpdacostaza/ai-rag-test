FROM python:3.11-slim

# Install required packages
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install requests httpx

# Create app directory and pipelines directory
WORKDIR /app
RUN mkdir -p /app/pipelines

# Copy only the installer scripts (memory components will be loaded from mounted volumes)
COPY scripts/auto_install_function.py /scripts/auto_install_function.py
COPY scripts/auto_install_pipeline.py /scripts/auto_install_pipeline.py
COPY scripts/unified_installer.py /scripts/unified_installer.py

# Set executable permissions
RUN chmod +x /scripts/*.py

# Run the unified installer from mounted app directory
# Memory components are loaded live from mounted volumes for zero-configuration updates
CMD ["python3", "/app/scripts/unified_installer.py"]
