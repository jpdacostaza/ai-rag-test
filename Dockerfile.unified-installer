FROM python:3.11-slim

# Install required packages
RUN apt-get update && apt-get install -y \
    gcc g++ make python3-dev build-essential \
    libffi-dev libssl-dev zlib1g-dev \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN python -m pip install --upgrade pip==23.3.1 wheel setuptools
RUN python -m pip install --timeout=1000 --retries=10 requests httpx

# Create app directory and pipelines directory
WORKDIR /app
RUN mkdir -p /app/pipelines

# Copy installer scripts and memory components
COPY scripts/auto_install_function.py /scripts/auto_install_function.py
COPY scripts/auto_install_pipeline.py /scripts/auto_install_pipeline.py
COPY scripts/unified_installer.py /scripts/unified_installer.py
COPY memory/functions/memory_function.py /app/memory_function.py
COPY pipelines/enhanced_memory_pipeline.py /app/enhanced_memory_pipeline.py

# Set executable permissions
RUN chmod +x /scripts/*.py

# Run the unified installer from mounted app directory
CMD ["python3", "/app/scripts/unified_installer.py"]
