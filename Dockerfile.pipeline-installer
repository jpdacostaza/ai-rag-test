FROM python:3.11-slim

# Install required dependencies
RUN pip install requests

# Create working directory
WORKDIR /app

# Copy the pipeline auto-installer script
COPY scripts/auto_install_pipeline.py .
COPY memory_pipeline.py .

# Set environment variables
ENV PIPELINES_URL=http://pipelines:9099
ENV PIPELINE_FILE=/app/memory_pipeline.py

# Run the auto-installer
CMD ["python", "auto_install_pipeline.py"]
